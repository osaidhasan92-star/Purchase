# Generate a long random hex password; do not commit your populated .env.
POSTGRES_PASSWORD=replace_with_a_random_hex_password
PUBLIC_ORIGIN=https://erp.example.com
# Maximum PostgreSQL ERP-control lock acquisition wait in milliseconds (1..60000).
# Busy acquisition rolls back and returns 503; this does not remove write serialization.
ERP_LOCK_TIMEOUT_MS=5000

# PostgreSQL HR resource concurrency (including payroll with a serialized financial tail); false restores the global path.
HR_RESOURCE_LOCKING=true

# Native Inventory/Trade/Production/Expenses/Finance resource paths on PostgreSQL.
RESOURCE_CONCURRENCY=true

# Independent approvals are enabled by default. Configure PKR role limits in Pending Approvals.
# False is for isolated legacy workflow benchmarks/tests, never a controlled deployment.
APPROVAL_CONTROLS_ENABLED=true

# Optional read-only AI assistant. Configure both values to enable it.
OPENAI_API_KEY=
ERP_AI_MODEL=
